VITE_FIREBASE_API_KEY=your_api_key
# Local development may use your_project.firebaseapp.com. Firebase Hosting
# builds override this to the same host as the deployed app.
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Optional: browser error and Web Vitals collector endpoint.
VITE_ERROR_REPORT_URL=
# Optional: Sentry/GlitchTip DSN. Loaded only when configured.
VITE_SENTRY_DSN=
# Optional: Firebase App Check reCAPTCHA v3 site key. App Check is skipped when empty.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Optional: local App Check debug token. Do not set this in production.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
