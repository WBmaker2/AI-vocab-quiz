rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacherOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPublishedSet() {
      return resource.data.published == true;
    }

    function isMatchingLeaderboardPeriodType(periodType) {
      return periodType == 'week' || periodType == 'month' || periodType == 'year' || periodType == 'school_all';
    }

    function isNonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function isNonNegativeInteger(value) {
      return value is int && value >= 0;
    }

    function isStudentBadgeId(badgeId) {
      return badgeId == 'first_challenge'
        || badgeId == 'listening_star'
        || badgeId == 'speaking_bravery'
        || badgeId == 'matching_speed'
        || badgeId == 'practice_keeper';
    }

    function isStudentProfileToken(profileToken) {
      return profileToken is string
        && profileToken.matches('^[0-9a-f]{32}$');
    }

    function isStudentProfileId(profileId, schoolId, grade, studentNameNormalized, profileToken) {
      return profileId == schoolId + "__" + grade + "__" + studentNameNormalized + "__" + profileToken;
    }

    function studentProfileNumber(data, fieldName) {
      return data.keys().hasAny([fieldName]) ? data[fieldName] : 0;
    }

    function hasOnlyStudentProfileFields(data) {
      return data.keys().hasOnly([
          'schoolId',
          'schoolName',
          'grade',
          'studentName',
          'studentNameNormalized',
          'profileToken',
          'totalSessions',
          'listeningSessions',
          'speakingSessions',
          'matchingSessions',
          'typingSessions',
          'listeningBestScore',
          'listeningBestCorrectCount',
          'speakingBestScore',
          'speakingBestCorrectCount',
          'matchingBestScore',
          'matchingBestTime',
          'typingBestScore',
          'typingBestCorrectCount',
          'typingBestAccuracy',
          'typingBestQuestionCount',
          'typingBestHintUsedCount',
          'typingBestCombo',
          'typingBestElapsedSeconds',
          'typingLastPlayedAt',
          'earnedBadges',
          'createdAt',
          'updatedAt'
        ]);
    }

    function isStudentProfileDocument(data) {
      return hasOnlyStudentProfileFields(data)
        && data.schoolId is string
        && data.schoolId.size() > 0
        && data.schoolName is string
        && data.schoolName.size() > 0
        && data.grade is string
        && data.grade.size() > 0
        && data.studentName is string
        && data.studentName.size() > 0
        && data.studentNameNormalized is string
        && data.studentNameNormalized.size() > 0
        && isStudentProfileToken(data.profileToken)
        && isNonNegativeNumber(data.totalSessions)
        && isNonNegativeNumber(data.listeningSessions)
        && isNonNegativeNumber(data.speakingSessions)
        && isNonNegativeNumber(data.matchingSessions)
        && isNonNegativeNumber(data.typingSessions)
        && isNonNegativeNumber(data.listeningBestScore)
        && isNonNegativeNumber(data.listeningBestCorrectCount)
        && isNonNegativeNumber(data.speakingBestScore)
        && isNonNegativeNumber(data.speakingBestCorrectCount)
        && isNonNegativeNumber(data.matchingBestScore)
        && isNonNegativeNumber(data.matchingBestTime)
        && isNonNegativeNumber(data.typingBestScore)
        && isNonNegativeNumber(data.typingBestCorrectCount)
        && isNonNegativeNumber(data.typingBestAccuracy)
        && isNonNegativeNumber(data.typingBestQuestionCount)
        && isNonNegativeNumber(data.typingBestHintUsedCount)
        && isNonNegativeNumber(data.typingBestCombo)
        && isNonNegativeNumber(data.typingBestElapsedSeconds)
        && (data.typingLastPlayedAt == null || data.typingLastPlayedAt is timestamp)
        && data.earnedBadges is list
        && data.earnedBadges.hasOnly([
          'first_challenge',
          'listening_star',
          'speaking_bravery',
          'matching_speed',
          'practice_keeper'
        ])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isStudentProfileWrite(profileId) {
      return isStudentProfileDocument(request.resource.data)
        && isStudentProfileId(
          profileId,
          request.resource.data.schoolId,
          request.resource.data.grade,
          request.resource.data.studentNameNormalized,
          request.resource.data.profileToken
        );
    }

    function isStudentProfileUpdateWrite(profileId) {
      return hasOnlyStudentProfileFields(request.resource.data)
        && isStudentProfileToken(request.resource.data.profileToken)
        && isStudentProfileId(
          profileId,
          request.resource.data.schoolId,
          request.resource.data.grade,
          request.resource.data.studentNameNormalized,
          request.resource.data.profileToken
        );
    }

    function studentProfileFieldChanged(fieldName) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName]);
    }

    function areChangedStudentProfileSessionsValid() {
      return (!studentProfileFieldChanged('totalSessions') || isNonNegativeInteger(request.resource.data.totalSessions))
        && (!studentProfileFieldChanged('listeningSessions') || isNonNegativeInteger(request.resource.data.listeningSessions))
        && (!studentProfileFieldChanged('speakingSessions') || isNonNegativeInteger(request.resource.data.speakingSessions))
        && (!studentProfileFieldChanged('matchingSessions') || isNonNegativeInteger(request.resource.data.matchingSessions))
        && (!studentProfileFieldChanged('typingSessions') || isNonNegativeInteger(request.resource.data.typingSessions));
    }

    function areChangedListeningProfileBestFieldsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'listeningBestScore',
          'listeningBestCorrectCount'
        ])
        || (
          isNonNegativeInteger(request.resource.data.listeningBestScore)
          && isNonNegativeInteger(request.resource.data.listeningBestCorrectCount)
        );
    }

    function areChangedSpeakingProfileBestFieldsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'speakingBestScore',
          'speakingBestCorrectCount'
        ])
        || (
          isNonNegativeInteger(request.resource.data.speakingBestScore)
          && isNonNegativeInteger(request.resource.data.speakingBestCorrectCount)
        );
    }

    function areChangedMatchingProfileBestFieldsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'matchingBestScore',
          'matchingBestTime'
        ])
        || (
          isNonNegativeInteger(request.resource.data.matchingBestScore)
          && isNonNegativeInteger(request.resource.data.matchingBestTime)
        );
    }

    function areChangedTypingProfileBestFieldsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'typingBestScore',
          'typingBestCorrectCount',
          'typingBestAccuracy',
          'typingBestQuestionCount',
          'typingBestHintUsedCount',
          'typingBestCombo',
          'typingBestElapsedSeconds'
        ])
        || (
          isNonNegativeInteger(request.resource.data.typingBestScore)
          && isNonNegativeInteger(request.resource.data.typingBestCorrectCount)
          && isNonNegativeInteger(request.resource.data.typingBestAccuracy)
          && isNonNegativeInteger(request.resource.data.typingBestQuestionCount)
          && isNonNegativeInteger(request.resource.data.typingBestHintUsedCount)
          && isNonNegativeInteger(request.resource.data.typingBestCombo)
          && isNonNegativeInteger(request.resource.data.typingBestElapsedSeconds)
        );
    }

    function areChangedStudentProfileBadgesValid() {
      return !studentProfileFieldChanged('earnedBadges')
        || (
          request.resource.data.earnedBadges is list
          && request.resource.data.earnedBadges.hasOnly([
            'first_challenge',
            'listening_star',
            'speaking_bravery',
            'matching_speed',
            'practice_keeper'
          ])
        );
    }

    function isStudentProfileRead(profileId) {
      return isStudentProfileDocument(resource.data)
        && isStudentProfileId(
          profileId,
          resource.data.schoolId,
          resource.data.grade,
          resource.data.studentNameNormalized,
          resource.data.profileToken
        );
    }

    function studentProfileSessionsMatchTotal(data) {
      return data.totalSessions
        == data.listeningSessions + data.speakingSessions + data.matchingSessions + data.typingSessions;
    }

    function isStudentProfileFirstSessionShape(data) {
      return studentProfileSessionsMatchTotal(data)
        && (
          (data.listeningSessions == 1 && data.speakingSessions == 0 && data.matchingSessions == 0 && data.typingSessions == 0)
          || (data.listeningSessions == 0 && data.speakingSessions == 1 && data.matchingSessions == 0 && data.typingSessions == 0)
          || (data.listeningSessions == 0 && data.speakingSessions == 0 && data.matchingSessions == 1 && data.typingSessions == 0)
          || (data.listeningSessions == 0 && data.speakingSessions == 0 && data.matchingSessions == 0 && data.typingSessions == 1)
        );
    }

    function isStudentProfileSingleSessionAdvance() {
      return request.resource.data.listeningSessions >= resource.data.listeningSessions
        && request.resource.data.speakingSessions >= resource.data.speakingSessions
        && request.resource.data.matchingSessions >= resource.data.matchingSessions
        && request.resource.data.typingSessions >= studentProfileNumber(resource.data, 'typingSessions')
        && request.resource.data.listeningSessions <= resource.data.listeningSessions + 1
        && request.resource.data.speakingSessions <= resource.data.speakingSessions + 1
        && request.resource.data.matchingSessions <= resource.data.matchingSessions + 1
        && request.resource.data.typingSessions <= studentProfileNumber(resource.data, 'typingSessions') + 1
        && studentProfileSessionsMatchTotal(request.resource.data)
        && (
          request.resource.data.listeningSessions - resource.data.listeningSessions
          + request.resource.data.speakingSessions - resource.data.speakingSessions
          + request.resource.data.matchingSessions - resource.data.matchingSessions
          + request.resource.data.typingSessions - studentProfileNumber(resource.data, 'typingSessions')
        ) == 1;
    }

    function isMatchingProfileBestImprovement() {
      return request.resource.data.matchingSessions == resource.data.matchingSessions + 1
        && (
          request.resource.data.matchingBestScore > resource.data.matchingBestScore
          || (
            request.resource.data.matchingBestScore == resource.data.matchingBestScore
            && (
              (
                resource.data.matchingSessions == 0
                && request.resource.data.matchingSessions == resource.data.matchingSessions + 1
              )
              || request.resource.data.matchingBestTime <= resource.data.matchingBestTime
            )
          )
        );
    }

    function isMatchingProfileBestUnchanged() {
      return request.resource.data.matchingBestScore == resource.data.matchingBestScore
        && request.resource.data.matchingBestTime == resource.data.matchingBestTime;
    }

    function isMatchingProfileBestUpdateAllowed() {
      return request.resource.data.matchingSessions == resource.data.matchingSessions
        ? isMatchingProfileBestUnchanged()
        : isMatchingProfileBestImprovement();
    }

    function isFirstTypingProfileSessionAdvance() {
      return studentProfileNumber(resource.data, 'typingSessions') == 0
        && request.resource.data.typingSessions == 1;
    }

    function isTypingProfileBestImprovementAfterBaseline() {
      let previousScore = studentProfileNumber(resource.data, 'typingBestScore');
      let previousCorrectCount = studentProfileNumber(resource.data, 'typingBestCorrectCount');
      let previousAccuracy = studentProfileNumber(resource.data, 'typingBestAccuracy');
      let previousQuestionCount = studentProfileNumber(resource.data, 'typingBestQuestionCount');
      let previousHintUsedCount = studentProfileNumber(resource.data, 'typingBestHintUsedCount');
      let previousCombo = studentProfileNumber(resource.data, 'typingBestCombo');
      let previousElapsedSeconds = studentProfileNumber(resource.data, 'typingBestElapsedSeconds');
      return (
          request.resource.data.typingBestScore == previousScore
          && request.resource.data.typingBestCorrectCount == previousCorrectCount
          && request.resource.data.typingBestAccuracy == previousAccuracy
          && request.resource.data.typingBestQuestionCount == previousQuestionCount
          && request.resource.data.typingBestHintUsedCount == previousHintUsedCount
          && request.resource.data.typingBestCombo == previousCombo
          && request.resource.data.typingBestElapsedSeconds == previousElapsedSeconds
        )
        || request.resource.data.typingBestScore > previousScore
        || (
          request.resource.data.typingBestScore == previousScore
          && request.resource.data.typingBestAccuracy > previousAccuracy
        )
        || (
          request.resource.data.typingBestScore == previousScore
          && request.resource.data.typingBestAccuracy == previousAccuracy
          && (
            previousElapsedSeconds == 0
            ? request.resource.data.typingBestElapsedSeconds > 0
            : request.resource.data.typingBestElapsedSeconds
              < previousElapsedSeconds
          )
        )
        || (
          request.resource.data.typingBestScore == previousScore
          && request.resource.data.typingBestAccuracy == previousAccuracy
          && request.resource.data.typingBestElapsedSeconds == previousElapsedSeconds
          && request.resource.data.typingBestCombo > previousCombo
        );
    }

    function isTypingProfileBestImprovement() {
      return isFirstTypingProfileSessionAdvance()
        || isTypingProfileBestImprovementAfterBaseline();
    }

    function isMatchingLeaderboardScopeKey(scopeKey, schoolId, grade, periodType, periodKey) {
      return scopeKey == schoolId + "__" + grade + "__" + periodType + "__" + periodKey;
    }

    function teacherDoc(uid) {
      return get(/databases/$(database)/documents/teachers/$(uid));
    }

    function teacherDocExists(uid) {
      return exists(/databases/$(database)/documents/teachers/$(uid));
    }

    function isTeacherForSchool(schoolId) {
      return isSignedIn()
        && teacherDocExists(request.auth.uid)
        && teacherDoc(request.auth.uid).data.isActive == true
        && teacherDoc(request.auth.uid).data.schoolId == schoolId;
    }

    function isMatchingLeaderboardDocument(data) {
      return data.keys().hasOnly([
          'scopeKey',
          'schoolId',
          'schoolName',
          'grade',
          'studentName',
          'studentNameNormalized',
          'periodType',
          'periodKey',
          'score',
          'elapsedSeconds',
          'solvedPairs',
          'createdAt',
          'updatedAt'
        ])
        && data.scopeKey is string
        && data.scopeKey.size() > 0
        && data.schoolId is string
        && data.schoolId.size() > 0
        && data.schoolName is string
        && data.schoolName.size() > 0
        && data.grade is string
        && data.grade.size() > 0
        && data.studentName is string
        && data.studentName.size() > 0
        && data.studentNameNormalized is string
        && data.studentNameNormalized.size() > 0
        && isMatchingLeaderboardPeriodType(data.periodType)
        && data.periodKey is string
        && data.periodKey.size() > 0
        && isMatchingLeaderboardScopeKey(
          data.scopeKey,
          data.schoolId,
          data.grade,
          data.periodType,
          data.periodKey
        )
        && isNonNegativeNumber(data.score)
        && data.score <= data.solvedPairs * 100
        && data.elapsedSeconds is int
        && data.elapsedSeconds >= 0
        && data.elapsedSeconds <= 7200
        && data.solvedPairs is int
        && data.solvedPairs >= 1
        && data.solvedPairs <= 100;
    }

    function isMatchingLeaderboardStudentWrite() {
      return isMatchingLeaderboardDocument(request.resource.data)
        && request.resource.data.scopeKey == request.resource.data.schoolId + "__" + request.resource.data.grade + "__" + request.resource.data.periodType + "__" + request.resource.data.periodKey;
    }

    function isMatchingLeaderboardTeacherCreate(studentKey) {
      return isMatchingLeaderboardDocument(request.resource.data)
        && isTeacherForSchool(request.resource.data.schoolId)
        && studentKey == request.resource.data.studentNameNormalized;
    }

    function isMatchingLeaderboardTeacherUpdate(studentKey) {
      return isMatchingLeaderboardTeacherCreate(studentKey)
        && resource.data.schoolId == request.resource.data.schoolId
        && resource.data.grade == request.resource.data.grade
        && resource.data.periodType == request.resource.data.periodType
        && resource.data.periodKey == request.resource.data.periodKey;
    }

    function isMatchingLeaderboardTeacherDelete() {
      return isTeacherForSchool(resource.data.schoolId);
    }

    function isFishingLeaderboardDocument(data) {
      return data.keys().hasOnly([
          'scopeKey',
          'schoolId',
          'schoolName',
          'grade',
          'studentName',
          'studentNameNormalized',
          'periodType',
          'periodKey',
          'score',
          'elapsedSeconds',
          'correctCount',
          'wrongCount',
          'missCount',
          'createdAt',
          'updatedAt'
        ])
        && data.scopeKey is string
        && data.scopeKey.size() > 0
        && data.schoolId is string
        && data.schoolId.size() > 0
        && data.schoolName is string
        && data.schoolName.size() > 0
        && data.grade is string
        && data.grade.size() > 0
        && data.studentName is string
        && data.studentName.size() > 0
        && data.studentNameNormalized is string
        && data.studentNameNormalized.size() > 0
        && isMatchingLeaderboardPeriodType(data.periodType)
        && data.periodKey is string
        && data.periodKey.size() > 0
        && isMatchingLeaderboardScopeKey(
          data.scopeKey,
          data.schoolId,
          data.grade,
          data.periodType,
          data.periodKey
        )
        && isNonNegativeNumber(data.score)
        && data.score <= data.correctCount * 140
        && isNonNegativeNumber(data.elapsedSeconds)
        && isNonNegativeInteger(data.correctCount)
        && isNonNegativeInteger(data.wrongCount)
        && isNonNegativeInteger(data.missCount)
        && data.correctCount + data.wrongCount + data.missCount >= 1
        && data.correctCount + data.wrongCount + data.missCount <= 10;
    }

    function isFishingLeaderboardStudentWrite() {
      return isFishingLeaderboardDocument(request.resource.data)
        && request.resource.data.scopeKey == request.resource.data.schoolId + "__" + request.resource.data.grade + "__" + request.resource.data.periodType + "__" + request.resource.data.periodKey;
    }

    function isFishingLeaderboardTeacherCreate(studentKey) {
      return isFishingLeaderboardDocument(request.resource.data)
        && isTeacherForSchool(request.resource.data.schoolId)
        && studentKey == request.resource.data.studentNameNormalized;
    }

    function isFishingLeaderboardTeacherUpdate(studentKey) {
      return isFishingLeaderboardTeacherCreate(studentKey)
        && resource.data.schoolId == request.resource.data.schoolId
        && resource.data.grade == request.resource.data.grade
        && resource.data.periodType == request.resource.data.periodType
        && resource.data.periodKey == request.resource.data.periodKey;
    }

    function isFishingLeaderboardTeacherDelete() {
      return isTeacherForSchool(resource.data.schoolId);
    }

    function isTypingLeaderboardDocument(data) {
      return data.keys().hasOnly([
          'scopeKey',
          'schoolId',
          'schoolName',
          'grade',
          'studentName',
          'studentNameNormalized',
          'periodType',
          'periodKey',
          'score',
          'elapsedSeconds',
          'questionCount',
          'correctCount',
          'accuracy',
          'hintUsedCount',
          'bestCombo',
          'createdAt',
          'updatedAt'
        ])
        && data.scopeKey is string
        && data.scopeKey.size() > 0
        && data.schoolId is string
        && data.schoolId.size() > 0
        && data.schoolName is string
        && data.schoolName.size() > 0
        && data.grade is string
        && data.grade.size() > 0
        && data.studentName is string
        && data.studentName.size() > 0
        && data.studentNameNormalized is string
        && data.studentNameNormalized.size() > 0
        && isMatchingLeaderboardPeriodType(data.periodType)
        && data.periodKey is string
        && data.periodKey.size() > 0
        && isMatchingLeaderboardScopeKey(
          data.scopeKey,
          data.schoolId,
          data.grade,
          data.periodType,
          data.periodKey
        )
        && isNonNegativeNumber(data.score)
        && data.score <= data.correctCount * 140
        && data.elapsedSeconds is int
        && data.elapsedSeconds >= 0
        && data.elapsedSeconds <= 86400
        && data.questionCount is int
        && data.questionCount >= 1
        && data.questionCount <= 500
        && isNonNegativeInteger(data.correctCount)
        && data.correctCount <= data.questionCount
        && isNonNegativeInteger(data.accuracy)
        && data.accuracy <= 100
        && math.abs(data.accuracy * data.questionCount - data.correctCount * 100) <= data.questionCount
        && isNonNegativeInteger(data.hintUsedCount)
        && data.hintUsedCount <= data.questionCount
        && isNonNegativeInteger(data.bestCombo)
        && data.bestCombo <= data.correctCount;
    }

    function isTypingLeaderboardStudentWrite() {
      return isTypingLeaderboardDocument(request.resource.data)
        && request.resource.data.scopeKey == request.resource.data.schoolId + "__" + request.resource.data.grade + "__" + request.resource.data.periodType + "__" + request.resource.data.periodKey;
    }

    function isTypingLeaderboardTeacherCreate(studentKey) {
      return isTypingLeaderboardDocument(request.resource.data)
        && isTeacherForSchool(request.resource.data.schoolId)
        && studentKey == request.resource.data.studentNameNormalized;
    }

    function isTypingLeaderboardTeacherUpdate(studentKey) {
      return isTypingLeaderboardTeacherCreate(studentKey)
        && resource.data.schoolId == request.resource.data.schoolId
        && resource.data.grade == request.resource.data.grade
        && resource.data.periodType == request.resource.data.periodType
        && resource.data.periodKey == request.resource.data.periodKey;
    }

    function isTypingLeaderboardTeacherDelete() {
      return isTeacherForSchool(resource.data.schoolId);
    }

    function isTypingLeaderboardStudentImprovement() {
      return request.resource.data.score > resource.data.score
        || (
          request.resource.data.score == resource.data.score
          && request.resource.data.accuracy > resource.data.accuracy
        )
        || (
          request.resource.data.score == resource.data.score
          && request.resource.data.accuracy == resource.data.accuracy
          && request.resource.data.elapsedSeconds < resource.data.elapsedSeconds
        )
        || (
          request.resource.data.score == resource.data.score
          && request.resource.data.accuracy == resource.data.accuracy
          && request.resource.data.elapsedSeconds == resource.data.elapsedSeconds
          && request.resource.data.bestCombo > resource.data.bestCombo
        );
    }

    function isLeaderboardTiedScoreFasterElapsed() {
      return request.resource.data.score > resource.data.score
        || (
          request.resource.data.score == resource.data.score
          && request.resource.data.elapsedSeconds < resource.data.elapsedSeconds
        );
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'normalizedName', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.normalizedName is string;
      allow update, delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if resource.data.isActive == true || isTeacherOwner(teacherId);
      allow create: if isTeacherOwner(teacherId)
        && request.resource.data.keys().hasOnly([
          'teacherName',
          'schoolId',
          'schoolName',
          'isActive',
          'gradePublishers',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.teacherName.size() <= 80
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0
        && request.resource.data.isActive == false
        && (
          !request.resource.data.keys().hasAny(['gradePublishers'])
          || request.resource.data.gradePublishers is map
        );
      allow update: if isTeacherOwner(teacherId)
        && request.resource.data.keys().hasOnly([
          'teacherName',
          'schoolId',
          'schoolName',
          'isActive',
          'gradePublishers',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.teacherName.size() <= 80
        && request.resource.data.schoolId is string
        && request.resource.data.schoolName is string
        && request.resource.data.isActive is bool
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.schoolName == resource.data.schoolName
        && (
          !request.resource.data.keys().hasAny(['gradePublishers'])
          || request.resource.data.gradePublishers is map
        );
      allow delete: if isTeacherOwner(teacherId);
    }

    match /studentProfiles/{profileId} {
      allow get: if isStudentProfileRead(profileId);
      allow list: if false;

      allow create: if isStudentProfileWrite(profileId)
        && request.resource.data.totalSessions == 1
        && isStudentProfileFirstSessionShape(request.resource.data);

      allow update: if isStudentProfileUpdateWrite(profileId)
        && areChangedStudentProfileSessionsValid()
        && areChangedListeningProfileBestFieldsValid()
        && areChangedSpeakingProfileBestFieldsValid()
        && areChangedMatchingProfileBestFieldsValid()
        && areChangedTypingProfileBestFieldsValid()
        && areChangedStudentProfileBadgesValid()
        && isMatchingProfileBestUpdateAllowed()
        && resource.data.schoolId == request.resource.data.schoolId
        && resource.data.schoolName == request.resource.data.schoolName
        && resource.data.grade == request.resource.data.grade
        && resource.data.studentName == request.resource.data.studentName
        && resource.data.studentNameNormalized == request.resource.data.studentNameNormalized
        && resource.data.profileToken == request.resource.data.profileToken
        && resource.data.createdAt == request.resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.totalSessions == resource.data.totalSessions + 1
        && isStudentProfileSingleSessionAdvance()
        && request.resource.data.listeningBestScore >= resource.data.listeningBestScore
        && request.resource.data.listeningBestCorrectCount >= resource.data.listeningBestCorrectCount
        && request.resource.data.speakingBestScore >= resource.data.speakingBestScore
        && request.resource.data.speakingBestCorrectCount >= resource.data.speakingBestCorrectCount
        && isTypingProfileBestImprovement()
        && request.resource.data.typingBestElapsedSeconds >= 0
        && (request.resource.data.typingLastPlayedAt == null || request.resource.data.typingLastPlayedAt is timestamp)
        && request.resource.data.earnedBadges.hasAll(resource.data.earnedBadges)
        && request.resource.data.earnedBadges.size() >= resource.data.earnedBadges.size();

      allow delete: if false;
    }

    match /vocabularySets/{setId} {
      allow read: if isPublishedSet() || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid
      );

      allow create: if isTeacherForSchool(request.resource.data.schoolId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schoolName == teacherDoc(request.auth.uid).data.schoolName
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'schoolId',
          'schoolName',
          'teacherName',
          'grade',
          'unit',
          'publisher',
          'published',
          'sourceType',
          'items',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schoolId is string
        && request.resource.data.schoolName is string
        && request.resource.data.teacherName is string
        && request.resource.data.grade is string
        && request.resource.data.unit is string
        && (
          !request.resource.data.keys().hasAny(['publisher'])
          || request.resource.data.publisher is string
        )
        && request.resource.data.published is bool
        && request.resource.data.sourceType is string
        && request.resource.data.items is list;
      allow update: if isTeacherForSchool(request.resource.data.schoolId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.schoolName == resource.data.schoolName
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'schoolId',
          'schoolName',
          'teacherName',
          'grade',
          'unit',
          'publisher',
          'published',
          'sourceType',
          'items',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schoolId is string
        && request.resource.data.schoolName is string
        && request.resource.data.teacherName is string
        && request.resource.data.grade is string
        && request.resource.data.unit is string
        && (
          !request.resource.data.keys().hasAny(['publisher'])
          || request.resource.data.publisher is string
        )
        && request.resource.data.published is bool
        && request.resource.data.sourceType is string
        && request.resource.data.items is list;

      allow delete: if isTeacherForSchool(resource.data.schoolId)
        && resource.data.ownerUid == request.auth.uid;
    }

    match /matchingLeaderboards/{scopeKey} {
      allow read, write: if false;

      match /entries/{studentKey} {
        allow read: if true;

        allow create: if (
          isMatchingLeaderboardStudentWrite()
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized
        ) || (
          isMatchingLeaderboardTeacherCreate(studentKey)
          && scopeKey == request.resource.data.scopeKey
        );

        allow update: if isMatchingLeaderboardStudentWrite()
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized
          && resource.data.scopeKey == request.resource.data.scopeKey
          && resource.data.schoolId == request.resource.data.schoolId
          && resource.data.schoolName == request.resource.data.schoolName
          && resource.data.grade == request.resource.data.grade
          && resource.data.studentNameNormalized == request.resource.data.studentNameNormalized
          && resource.data.periodType == request.resource.data.periodType
          && resource.data.periodKey == request.resource.data.periodKey
          && isLeaderboardTiedScoreFasterElapsed();

        allow update: if isMatchingLeaderboardTeacherUpdate(studentKey)
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized;

        allow delete: if isMatchingLeaderboardTeacherDelete();
      }
    }

    match /fishingLeaderboards/{scopeKey} {
      allow read, write: if false;

      match /entries/{studentKey} {
        allow read: if true;

        allow create: if (
          isFishingLeaderboardStudentWrite()
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized
        ) || (
          isFishingLeaderboardTeacherCreate(studentKey)
          && scopeKey == request.resource.data.scopeKey
        );

        allow update: if isFishingLeaderboardStudentWrite()
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized
          && resource.data.scopeKey == request.resource.data.scopeKey
          && resource.data.schoolId == request.resource.data.schoolId
          && resource.data.schoolName == request.resource.data.schoolName
          && resource.data.grade == request.resource.data.grade
          && resource.data.studentNameNormalized == request.resource.data.studentNameNormalized
          && resource.data.periodType == request.resource.data.periodType
          && resource.data.periodKey == request.resource.data.periodKey
          && isLeaderboardTiedScoreFasterElapsed();

        allow update: if isFishingLeaderboardTeacherUpdate(studentKey)
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized;

        allow delete: if isFishingLeaderboardTeacherDelete();
      }
    }

    match /typingLeaderboards/{scopeKey} {
      allow read, write: if false;

      match /entries/{studentKey} {
        allow read: if true;

        allow create: if (
          isTypingLeaderboardStudentWrite()
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized
        ) || (
          isTypingLeaderboardTeacherCreate(studentKey)
          && scopeKey == request.resource.data.scopeKey
        );

        allow update: if isTypingLeaderboardStudentWrite()
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized
          && resource.data.scopeKey == request.resource.data.scopeKey
          && resource.data.schoolId == request.resource.data.schoolId
          && resource.data.schoolName == request.resource.data.schoolName
          && resource.data.grade == request.resource.data.grade
          && resource.data.studentNameNormalized == request.resource.data.studentNameNormalized
          && resource.data.periodType == request.resource.data.periodType
          && resource.data.periodKey == request.resource.data.periodKey
          && isTypingLeaderboardStudentImprovement();

        allow update: if isTypingLeaderboardTeacherUpdate(studentKey)
          && scopeKey == request.resource.data.scopeKey
          && studentKey == request.resource.data.studentNameNormalized;

        allow delete: if isTypingLeaderboardTeacherDelete();
      }
    }

    function bingoSessionDoc(sessionId) {
      return get(/databases/$(database)/documents/bingoSessions/$(sessionId));
    }

    function bingoSessionActiveWordId(sessionId) {
      return bingoSessionDoc(sessionId).data.activeWordId;
    }

    function bingoSessionExists(sessionId) {
      return exists(/databases/$(database)/documents/bingoSessions/$(sessionId));
    }

    function isBingoBoardSize(boardSize) {
      return boardSize == 3 || boardSize == 4;
    }

    function isBingoSessionMode(mode) {
      return mode == 'manual' || mode == 'tts';
    }

    function isBingoSessionStatus(status) {
      return status == 'waiting' || status == 'live' || status == 'finished';
    }

    function isBingoSessionDocument(data) {
      return data.keys().hasOnly([
          'sessionCode',
          'teacherUserId',
          'teacherName',
          'schoolId',
          'schoolName',
          'grade',
          'unit',
          'publisher',
          'selectedUnits',
          'selectedUnitLabels',
          'requiredCellCount',
          'mode',
          'boardSize',
          'status',
          'activeWordId',
          'activeWordText',
          'activeWordMeaning',
          'callSequence',
          'calledWordIds',
          'vocabularyItems',
          'createdAt',
          'updatedAt',
          'finishedAt',
          'finishedBy'
        ])
        && data.sessionCode is string
        && data.sessionCode.size() > 0
        && data.teacherUserId is string
        && data.teacherUserId.size() > 0
        && data.teacherName is string
        && data.teacherName.size() > 0
        && data.schoolId is string
        && data.schoolId.size() > 0
        && data.schoolName is string
        && data.schoolName.size() > 0
        && data.grade is string
        && data.grade.size() > 0
        && data.unit is string
        && data.unit.size() > 0
        && data.publisher is string
        && data.selectedUnits is list
        && data.selectedUnits.size() > 0
        && data.selectedUnitLabels is list
        && data.selectedUnitLabels.size() > 0
        && data.requiredCellCount is int
        && data.requiredCellCount >= 9
        && data.mode is string
        && isBingoSessionMode(data.mode)
        && isBingoBoardSize(data.boardSize)
        && data.requiredCellCount == data.boardSize * data.boardSize
        && data.status is string
        && isBingoSessionStatus(data.status)
        && data.activeWordId is string
        && data.activeWordText is string
        && data.activeWordMeaning is string
        && data.callSequence is list
        && data.calledWordIds is list
        && data.vocabularyItems is list
        && data.vocabularyItems.size() >= 9
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.finishedAt == null || data.finishedAt is timestamp)
        && data.finishedBy is string;
    }

    function isBingoSessionCreate(sessionId) {
      return isSignedIn()
        && request.resource.data.sessionCode == sessionId
        && request.resource.data.teacherUserId == request.auth.uid
        && isTeacherForSchool(request.resource.data.schoolId)
        && isBingoSessionDocument(request.resource.data)
        && request.resource.data.status == 'live'
        && request.resource.data.activeWordId == ''
        && request.resource.data.activeWordText == ''
        && request.resource.data.activeWordMeaning == ''
        && request.resource.data.callSequence.size() == 0
        && request.resource.data.calledWordIds.size() == 0
        && request.resource.data.finishedAt == null
        && request.resource.data.finishedBy == '';
    }

    function isBingoSessionUpdate(sessionId) {
      return isSignedIn()
        && bingoSessionExists(sessionId)
        && bingoSessionDoc(sessionId).data.teacherUserId == request.auth.uid
        && isTeacherForSchool(request.resource.data.schoolId)
        && isBingoSessionDocument(request.resource.data)
        && request.resource.data.sessionCode == sessionId
        && request.resource.data.teacherUserId == resource.data.teacherUserId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.schoolName == resource.data.schoolName
        && request.resource.data.grade == resource.data.grade
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.publisher == resource.data.publisher
        && request.resource.data.selectedUnits == resource.data.selectedUnits
        && request.resource.data.selectedUnitLabels == resource.data.selectedUnitLabels
        && request.resource.data.requiredCellCount == resource.data.requiredCellCount
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.boardSize == resource.data.boardSize
        && request.resource.data.vocabularyItems == resource.data.vocabularyItems
        && request.resource.data.activeWordId is string
        && request.resource.data.activeWordText is string
        && request.resource.data.activeWordMeaning is string
        && request.resource.data.callSequence is list
        && request.resource.data.calledWordIds is list
        && isBingoSessionStatus(request.resource.data.status);
    }

    function isBingoPlayerCommonKeys(data) {
      return data.keys().hasOnly([
          'studentName',
          'studentNameNormalized',
          'boardSize',
          'requiredCellCount',
          'setupStatus',
          'availableWords',
          'boardCells',
          'boardWordIds',
          'markedWordIds',
          'bingoLines',
          'completedLineKeys',
          'hasBingo',
          'bingoRank',
          'setupStartedAt',
          'setupCompletedAt',
          'joinedAt',
          'updatedAt'
        ])
        && data.studentName is string
        && data.studentName.size() > 0
        && data.studentNameNormalized is string
        && data.studentNameNormalized.size() > 0
        && isBingoBoardSize(data.boardSize)
        && data.requiredCellCount is int
        && data.requiredCellCount == data.boardSize * data.boardSize
        && data.setupStatus is string
        && data.boardCells is list
        && data.boardWordIds is list
        && data.boardCells.size() == data.boardSize * data.boardSize
        && data.markedWordIds is list
        && data.bingoLines is int
        && data.bingoLines >= 0
        && data.completedLineKeys is list
        && data.hasBingo is bool
        && (data.bingoRank == null || data.bingoRank is int)
        && data.availableWords is list
        && data.availableWords.size() == data.boardSize * data.boardSize
        && (data.setupStartedAt == null || data.setupStartedAt is timestamp)
        && (data.setupCompletedAt == null || data.setupCompletedAt is timestamp)
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isBingoPlayerSetupDraftDocument(data) {
      return isBingoPlayerCommonKeys(data)
        && data.setupStatus == 'arranging'
        && data.boardWordIds.size() <= data.boardSize * data.boardSize
        && data.markedWordIds.size() == 0
        && data.bingoLines == 0
        && data.completedLineKeys.size() == 0
        && data.hasBingo == false
        && data.bingoRank == null
        && data.setupStartedAt is timestamp
        && data.setupCompletedAt == null;
    }

    function isBingoPlayerSetupCreateDocument3(boardCells) {
      return boardCells[0].wordId == ""
        && boardCells[0].word == ""
        && boardCells[1].wordId == ""
        && boardCells[1].word == ""
        && boardCells[2].wordId == ""
        && boardCells[2].word == ""
        && boardCells[3].wordId == ""
        && boardCells[3].word == ""
        && boardCells[4].wordId == ""
        && boardCells[4].word == ""
        && boardCells[5].wordId == ""
        && boardCells[5].word == ""
        && boardCells[6].wordId == ""
        && boardCells[6].word == ""
        && boardCells[7].wordId == ""
        && boardCells[7].word == ""
        && boardCells[8].wordId == ""
        && boardCells[8].word == "";
    }

    function isBingoPlayerSetupCreateDocument4(boardCells) {
      return isBingoPlayerSetupCreateDocument3(boardCells)
        && boardCells[9].wordId == ""
        && boardCells[9].word == ""
        && boardCells[10].wordId == ""
        && boardCells[10].word == ""
        && boardCells[11].wordId == ""
        && boardCells[11].word == ""
        && boardCells[12].wordId == ""
        && boardCells[12].word == ""
        && boardCells[13].wordId == ""
        && boardCells[13].word == ""
        && boardCells[14].wordId == ""
        && boardCells[14].word == ""
        && boardCells[15].wordId == ""
        && boardCells[15].word == "";
    }

    function isBingoPlayerSetupCreateDocument(boardCells, boardSize) {
      return boardSize == 3
        ? isBingoPlayerSetupCreateDocument3(boardCells)
        : boardSize == 4
          ? isBingoPlayerSetupCreateDocument4(boardCells)
          : false;
    }

    function isBingoPlayerCreateDocument(data) {
      return isBingoPlayerSetupDraftDocument(data)
        && data.boardWordIds.size() == 0
        && data.boardCells.size() == data.boardSize * data.boardSize
        && isBingoPlayerSetupCreateDocument(data.boardCells, data.boardSize);
    }

    function isBingoAvailableWordData(word) {
      return word is map
        && word.id is string
        && word.id.size() > 0;
    }

    function isBingoAvailableWordDataByBoardSize3(availableWords) {
      return availableWords.size() >= 9
        && isBingoAvailableWordData(availableWords[0])
        && isBingoAvailableWordData(availableWords[1])
        && isBingoAvailableWordData(availableWords[2])
        && isBingoAvailableWordData(availableWords[3])
        && isBingoAvailableWordData(availableWords[4])
        && isBingoAvailableWordData(availableWords[5])
        && isBingoAvailableWordData(availableWords[6])
        && isBingoAvailableWordData(availableWords[7])
        && isBingoAvailableWordData(availableWords[8]);
    }

    function isBingoAvailableWordDataByBoardSize4(availableWords) {
      return availableWords.size() >= 16
        && isBingoAvailableWordData(availableWords[0])
        && isBingoAvailableWordData(availableWords[1])
        && isBingoAvailableWordData(availableWords[2])
        && isBingoAvailableWordData(availableWords[3])
        && isBingoAvailableWordData(availableWords[4])
        && isBingoAvailableWordData(availableWords[5])
        && isBingoAvailableWordData(availableWords[6])
        && isBingoAvailableWordData(availableWords[7])
        && isBingoAvailableWordData(availableWords[8])
        && isBingoAvailableWordData(availableWords[9])
        && isBingoAvailableWordData(availableWords[10])
        && isBingoAvailableWordData(availableWords[11])
        && isBingoAvailableWordData(availableWords[12])
        && isBingoAvailableWordData(availableWords[13])
        && isBingoAvailableWordData(availableWords[14])
        && isBingoAvailableWordData(availableWords[15]);
    }

    function isBingoAvailableWordDataByBoardSize(availableWords, boardSize) {
      return boardSize == 3
        ? isBingoAvailableWordDataByBoardSize3(availableWords)
        : boardSize == 4
          ? isBingoAvailableWordDataByBoardSize4(availableWords)
          : false;
    }

    function isBingoAvailableWordIdsUniqueByBoardSize3(availableWords) {
      return [
          availableWords[0].id,
          availableWords[1].id,
          availableWords[2].id,
          availableWords[3].id,
          availableWords[4].id,
          availableWords[5].id,
          availableWords[6].id,
          availableWords[7].id,
          availableWords[8].id,
        ].toSet().size() == 9;
    }

    function isBingoAvailableWordIdsUniqueByBoardSize4(availableWords) {
      return [
          availableWords[0].id,
          availableWords[1].id,
          availableWords[2].id,
          availableWords[3].id,
          availableWords[4].id,
          availableWords[5].id,
          availableWords[6].id,
          availableWords[7].id,
          availableWords[8].id,
          availableWords[9].id,
          availableWords[10].id,
          availableWords[11].id,
          availableWords[12].id,
          availableWords[13].id,
          availableWords[14].id,
          availableWords[15].id,
        ].toSet().size() == 16;
    }

    function isBingoAvailableWordIdsUniqueByBoardSize(availableWords, boardSize) {
      return boardSize == 3
        ? isBingoAvailableWordIdsUniqueByBoardSize3(availableWords)
        : boardSize == 4
          ? isBingoAvailableWordIdsUniqueByBoardSize4(availableWords)
          : false;
    }

    function isBingoPlayerAvailableWordsAllowedBySession(availableWords, sessionVocabularyItems, boardSize) {
      return availableWords.size() == boardSize * boardSize
        && isBingoAvailableWordIdsUniqueByBoardSize(availableWords, boardSize)
        && availableWords.hasOnly(sessionVocabularyItems);
    }

    function isBingoPlayerBoardWordIdsAllowedByBoardSize3(boardWordIds, availableWords) {
      return availableWords.size() >= 9
        && boardWordIds.hasOnly([
          availableWords[0].id,
          availableWords[1].id,
          availableWords[2].id,
          availableWords[3].id,
          availableWords[4].id,
          availableWords[5].id,
          availableWords[6].id,
          availableWords[7].id,
          availableWords[8].id,
        ]);
    }

    function isBingoPlayerAvailableWordIdsMatchBoardSize3(boardWordIds, availableWords) {
      return boardWordIds.size() == 9
        && boardWordIds.hasAll([
          availableWords[0].id,
          availableWords[1].id,
          availableWords[2].id,
          availableWords[3].id,
          availableWords[4].id,
          availableWords[5].id,
          availableWords[6].id,
          availableWords[7].id,
          availableWords[8].id,
        ]);
    }

    function isBingoPlayerBoardWordIdsAllowedByBoardSize4(boardWordIds, availableWords) {
      return availableWords.size() >= 16
        && boardWordIds.hasOnly([
          availableWords[0].id,
          availableWords[1].id,
          availableWords[2].id,
          availableWords[3].id,
          availableWords[4].id,
          availableWords[5].id,
          availableWords[6].id,
          availableWords[7].id,
          availableWords[8].id,
          availableWords[9].id,
          availableWords[10].id,
          availableWords[11].id,
          availableWords[12].id,
          availableWords[13].id,
          availableWords[14].id,
          availableWords[15].id,
        ]);
    }

    function isBingoPlayerAvailableWordIdsMatchBoardSize4(boardWordIds, availableWords) {
      return boardWordIds.size() == 16
        && boardWordIds.hasAll([
          availableWords[0].id,
          availableWords[1].id,
          availableWords[2].id,
          availableWords[3].id,
          availableWords[4].id,
          availableWords[5].id,
          availableWords[6].id,
          availableWords[7].id,
          availableWords[8].id,
          availableWords[9].id,
          availableWords[10].id,
          availableWords[11].id,
          availableWords[12].id,
          availableWords[13].id,
          availableWords[14].id,
          availableWords[15].id
        ]);
    }

    function isBingoPlayerBoardWordIdsMatchAvailableByBoardSize(boardWordIds, availableWords, boardSize) {
      return boardSize == 3
        ? isBingoPlayerAvailableWordIdsMatchBoardSize3(boardWordIds, availableWords)
        : boardSize == 4
          ? isBingoPlayerAvailableWordIdsMatchBoardSize4(boardWordIds, availableWords)
          : false;
    }

    function isBingoPlayerBoardWordIdsAllowedByBoardSize(boardWordIds, availableWords, boardSize) {
      return boardSize == 3
        ? isBingoPlayerBoardWordIdsAllowedByBoardSize3(boardWordIds, availableWords)
        : boardSize == 4
          ? isBingoPlayerBoardWordIdsAllowedByBoardSize4(boardWordIds, availableWords)
          : false;
    }

    function isBingoBoardCellsMatchBoardWordIds3(boardCells, boardWordIds) {
      return boardCells[0] is map
        && boardCells[0].wordId is string
        && boardWordIds[0] == boardCells[0].wordId
        && boardCells[1] is map
        && boardCells[1].wordId is string
        && boardWordIds[1] == boardCells[1].wordId
        && boardCells[2] is map
        && boardCells[2].wordId is string
        && boardWordIds[2] == boardCells[2].wordId
        && boardCells[3] is map
        && boardCells[3].wordId is string
        && boardWordIds[3] == boardCells[3].wordId
        && boardCells[4] is map
        && boardCells[4].wordId is string
        && boardWordIds[4] == boardCells[4].wordId
        && boardCells[5] is map
        && boardCells[5].wordId is string
        && boardWordIds[5] == boardCells[5].wordId
        && boardCells[6] is map
        && boardCells[6].wordId is string
        && boardWordIds[6] == boardCells[6].wordId
        && boardCells[7] is map
        && boardCells[7].wordId is string
        && boardWordIds[7] == boardCells[7].wordId
        && boardCells[8] is map
        && boardCells[8].wordId is string
        && boardWordIds[8] == boardCells[8].wordId;
    }

    function isBingoBoardCellsMatchBoardWordIds4(boardCells, boardWordIds) {
      return boardCells[0] is map
        && boardCells[0].wordId is string
        && boardWordIds[0] == boardCells[0].wordId
        && boardCells[1] is map
        && boardCells[1].wordId is string
        && boardWordIds[1] == boardCells[1].wordId
        && boardCells[2] is map
        && boardCells[2].wordId is string
        && boardWordIds[2] == boardCells[2].wordId
        && boardCells[3] is map
        && boardCells[3].wordId is string
        && boardWordIds[3] == boardCells[3].wordId
        && boardCells[4] is map
        && boardCells[4].wordId is string
        && boardWordIds[4] == boardCells[4].wordId
        && boardCells[5] is map
        && boardCells[5].wordId is string
        && boardWordIds[5] == boardCells[5].wordId
        && boardCells[6] is map
        && boardCells[6].wordId is string
        && boardWordIds[6] == boardCells[6].wordId
        && boardCells[7] is map
        && boardCells[7].wordId is string
        && boardWordIds[7] == boardCells[7].wordId
        && boardCells[8] is map
        && boardCells[8].wordId is string
        && boardWordIds[8] == boardCells[8].wordId
        && boardCells[9] is map
        && boardCells[9].wordId is string
        && boardWordIds[9] == boardCells[9].wordId
        && boardCells[10] is map
        && boardCells[10].wordId is string
        && boardWordIds[10] == boardCells[10].wordId
        && boardCells[11] is map
        && boardCells[11].wordId is string
        && boardWordIds[11] == boardCells[11].wordId
        && boardCells[12] is map
        && boardCells[12].wordId is string
        && boardWordIds[12] == boardCells[12].wordId
        && boardCells[13] is map
        && boardCells[13].wordId is string
        && boardWordIds[13] == boardCells[13].wordId
        && boardCells[14] is map
        && boardCells[14].wordId is string
        && boardWordIds[14] == boardCells[14].wordId
        && boardCells[15] is map
        && boardCells[15].wordId is string
        && boardWordIds[15] == boardCells[15].wordId;
    }

    function isBingoDraftBoardCellListsMatch3(boardWordIds, boardCells) {
      return boardWordIds.hasOnly([
          boardCells[0].wordId,
          boardCells[1].wordId,
          boardCells[2].wordId,
          boardCells[3].wordId,
          boardCells[4].wordId,
          boardCells[5].wordId,
          boardCells[6].wordId,
          boardCells[7].wordId,
          boardCells[8].wordId,
        ]);
    }

    function isBingoDraftBoardCellListsMatch4(boardWordIds, boardCells) {
      return boardWordIds.hasOnly([
          boardCells[0].wordId,
          boardCells[1].wordId,
          boardCells[2].wordId,
          boardCells[3].wordId,
          boardCells[4].wordId,
          boardCells[5].wordId,
          boardCells[6].wordId,
          boardCells[7].wordId,
          boardCells[8].wordId,
          boardCells[9].wordId,
          boardCells[10].wordId,
          boardCells[11].wordId,
          boardCells[12].wordId,
          boardCells[13].wordId,
          boardCells[14].wordId,
          boardCells[15].wordId,
        ]);
    }

    function isBingoDraftBoardCellsMatch3(boardCells, boardWordIds) {
      return boardCells[0] is map
        && boardCells[0].wordId is string
        && (boardCells[0].wordId == "" || boardWordIds.hasAny([boardCells[0].wordId]))
        && boardCells[1] is map
        && boardCells[1].wordId is string
        && (boardCells[1].wordId == "" || boardWordIds.hasAny([boardCells[1].wordId]))
        && boardCells[2] is map
        && boardCells[2].wordId is string
        && (boardCells[2].wordId == "" || boardWordIds.hasAny([boardCells[2].wordId]))
        && boardCells[3] is map
        && boardCells[3].wordId is string
        && (boardCells[3].wordId == "" || boardWordIds.hasAny([boardCells[3].wordId]))
        && boardCells[4] is map
        && boardCells[4].wordId is string
        && (boardCells[4].wordId == "" || boardWordIds.hasAny([boardCells[4].wordId]))
        && boardCells[5] is map
        && boardCells[5].wordId is string
        && (boardCells[5].wordId == "" || boardWordIds.hasAny([boardCells[5].wordId]))
        && boardCells[6] is map
        && boardCells[6].wordId is string
        && (boardCells[6].wordId == "" || boardWordIds.hasAny([boardCells[6].wordId]))
        && boardCells[7] is map
        && boardCells[7].wordId is string
        && (boardCells[7].wordId == "" || boardWordIds.hasAny([boardCells[7].wordId]))
        && boardCells[8] is map
        && boardCells[8].wordId is string
        && (boardCells[8].wordId == "" || boardWordIds.hasAny([boardCells[8].wordId]))
        && isBingoDraftBoardCellListsMatch3(boardWordIds, boardCells);
    }

    function isBingoDraftBoardCellsMatch4(boardCells, boardWordIds) {
      return boardCells[0] is map
        && boardCells[0].wordId is string
        && (boardCells[0].wordId == "" || boardWordIds.hasAny([boardCells[0].wordId]))
        && boardCells[1] is map
        && boardCells[1].wordId is string
        && (boardCells[1].wordId == "" || boardWordIds.hasAny([boardCells[1].wordId]))
        && boardCells[2] is map
        && boardCells[2].wordId is string
        && (boardCells[2].wordId == "" || boardWordIds.hasAny([boardCells[2].wordId]))
        && boardCells[3] is map
        && boardCells[3].wordId is string
        && (boardCells[3].wordId == "" || boardWordIds.hasAny([boardCells[3].wordId]))
        && boardCells[4] is map
        && boardCells[4].wordId is string
        && (boardCells[4].wordId == "" || boardWordIds.hasAny([boardCells[4].wordId]))
        && boardCells[5] is map
        && boardCells[5].wordId is string
        && (boardCells[5].wordId == "" || boardWordIds.hasAny([boardCells[5].wordId]))
        && boardCells[6] is map
        && boardCells[6].wordId is string
        && (boardCells[6].wordId == "" || boardWordIds.hasAny([boardCells[6].wordId]))
        && boardCells[7] is map
        && boardCells[7].wordId is string
        && (boardCells[7].wordId == "" || boardWordIds.hasAny([boardCells[7].wordId]))
        && boardCells[8] is map
        && boardCells[8].wordId is string
        && (boardCells[8].wordId == "" || boardWordIds.hasAny([boardCells[8].wordId]))
        && boardCells[9] is map
        && boardCells[9].wordId is string
        && (boardCells[9].wordId == "" || boardWordIds.hasAny([boardCells[9].wordId]))
        && boardCells[10] is map
        && boardCells[10].wordId is string
        && (boardCells[10].wordId == "" || boardWordIds.hasAny([boardCells[10].wordId]))
        && boardCells[11] is map
        && boardCells[11].wordId is string
        && (boardCells[11].wordId == "" || boardWordIds.hasAny([boardCells[11].wordId]))
        && boardCells[12] is map
        && boardCells[12].wordId is string
        && (boardCells[12].wordId == "" || boardWordIds.hasAny([boardCells[12].wordId]))
        && boardCells[13] is map
        && boardCells[13].wordId is string
        && (boardCells[13].wordId == "" || boardWordIds.hasAny([boardCells[13].wordId]))
        && boardCells[14] is map
        && boardCells[14].wordId is string
        && (boardCells[14].wordId == "" || boardWordIds.hasAny([boardCells[14].wordId]))
        && boardCells[15] is map
        && boardCells[15].wordId is string
        && (boardCells[15].wordId == "" || boardWordIds.hasAny([boardCells[15].wordId]))
        && isBingoDraftBoardCellListsMatch4(boardWordIds, boardCells);
    }

    function isBingoDraftBoardCellsMatchByBoardSize(boardCells, boardWordIds, boardSize) {
      return boardSize == 3
        ? isBingoDraftBoardCellsMatch3(boardCells, boardWordIds)
        : boardSize == 4
          ? isBingoDraftBoardCellsMatch4(boardCells, boardWordIds)
          : false;
    }

    function isBingoBoardCellsMatchBoardWordIdsByBoardSize(boardCells, boardWordIds, boardSize) {
      return boardSize == 3
        ? isBingoBoardCellsMatchBoardWordIds3(boardCells, boardWordIds)
        : boardSize == 4
          ? isBingoBoardCellsMatchBoardWordIds4(boardCells, boardWordIds)
          : false;
    }

    function isBingoPlayerBoardLinesCompleted3(boardWordIds, markedWordIds) {
      return (markedWordIds.hasAll([boardWordIds[0], boardWordIds[1], boardWordIds[2]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[3], boardWordIds[4], boardWordIds[5]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[6], boardWordIds[7], boardWordIds[8]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[0], boardWordIds[3], boardWordIds[6]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[1], boardWordIds[4], boardWordIds[7]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[2], boardWordIds[5], boardWordIds[8]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[0], boardWordIds[4], boardWordIds[8]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[2], boardWordIds[4], boardWordIds[6]]) ? 1 : 0);
    }

    function isBingoPlayerBoardLinesCompleted4(boardWordIds, markedWordIds) {
      return (markedWordIds.hasAll([boardWordIds[0], boardWordIds[1], boardWordIds[2], boardWordIds[3]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[4], boardWordIds[5], boardWordIds[6], boardWordIds[7]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[8], boardWordIds[9], boardWordIds[10], boardWordIds[11]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[12], boardWordIds[13], boardWordIds[14], boardWordIds[15]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[0], boardWordIds[4], boardWordIds[8], boardWordIds[12]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[1], boardWordIds[5], boardWordIds[9], boardWordIds[13]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[2], boardWordIds[6], boardWordIds[10], boardWordIds[14]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[3], boardWordIds[7], boardWordIds[11], boardWordIds[15]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[0], boardWordIds[5], boardWordIds[10], boardWordIds[15]]) ? 1 : 0)
        + (markedWordIds.hasAll([boardWordIds[3], boardWordIds[6], boardWordIds[9], boardWordIds[12]]) ? 1 : 0);
    }

    function isBingoPlayerBoardLinesCompletedByBoardSize(boardWordIds, markedWordIds, boardSize) {
      return boardSize == 3
        ? isBingoPlayerBoardLinesCompleted3(boardWordIds, markedWordIds)
        : boardSize == 4
          ? isBingoPlayerBoardLinesCompleted4(boardWordIds, markedWordIds)
          : 0;
    }

    function isBingoPlayerCompletedLineKeysAllowed3(completedLineKeys) {
      return completedLineKeys.hasOnly([
        'line-0',
        'line-1',
        'line-2',
        'line-3',
        'line-4',
        'line-5',
        'line-6',
        'line-7',
      ]);
    }

    function isBingoPlayerCompletedLineKeysAllowed4(completedLineKeys) {
      return completedLineKeys.hasOnly([
        'line-0',
        'line-1',
        'line-2',
        'line-3',
        'line-4',
        'line-5',
        'line-6',
        'line-7',
        'line-8',
        'line-9',
      ]);
    }

    function isBingoPlayerCompletedLineKeysAllowedByBoardSize(completedLineKeys, boardSize) {
      return boardSize == 3
        ? isBingoPlayerCompletedLineKeysAllowed3(completedLineKeys)
        : boardSize == 4
          ? isBingoPlayerCompletedLineKeysAllowed4(completedLineKeys)
          : false;
    }

    function isBingoPlayerCompletedLineKeyComplete3(boardWordIds, markedWordIds, lineKey) {
      return lineKey == 'line-0'
        ? markedWordIds.hasAll([boardWordIds[0], boardWordIds[1], boardWordIds[2]])
        : lineKey == 'line-1'
          ? markedWordIds.hasAll([boardWordIds[3], boardWordIds[4], boardWordIds[5]])
          : lineKey == 'line-2'
            ? markedWordIds.hasAll([boardWordIds[6], boardWordIds[7], boardWordIds[8]])
            : lineKey == 'line-3'
              ? markedWordIds.hasAll([boardWordIds[0], boardWordIds[3], boardWordIds[6]])
              : lineKey == 'line-4'
                ? markedWordIds.hasAll([boardWordIds[1], boardWordIds[4], boardWordIds[7]])
                : lineKey == 'line-5'
                  ? markedWordIds.hasAll([boardWordIds[2], boardWordIds[5], boardWordIds[8]])
                  : lineKey == 'line-6'
                    ? markedWordIds.hasAll([boardWordIds[0], boardWordIds[4], boardWordIds[8]])
                    : lineKey == 'line-7'
                      ? markedWordIds.hasAll([boardWordIds[2], boardWordIds[4], boardWordIds[6]])
                      : false;
    }

    function isBingoPlayerCompletedLineKeyComplete4(boardWordIds, markedWordIds, lineKey) {
      return lineKey == 'line-0'
        ? markedWordIds.hasAll([boardWordIds[0], boardWordIds[1], boardWordIds[2], boardWordIds[3]])
        : lineKey == 'line-1'
          ? markedWordIds.hasAll([boardWordIds[4], boardWordIds[5], boardWordIds[6], boardWordIds[7]])
          : lineKey == 'line-2'
            ? markedWordIds.hasAll([boardWordIds[8], boardWordIds[9], boardWordIds[10], boardWordIds[11]])
            : lineKey == 'line-3'
              ? markedWordIds.hasAll([boardWordIds[12], boardWordIds[13], boardWordIds[14], boardWordIds[15]])
              : lineKey == 'line-4'
                ? markedWordIds.hasAll([boardWordIds[0], boardWordIds[4], boardWordIds[8], boardWordIds[12]])
                : lineKey == 'line-5'
                  ? markedWordIds.hasAll([boardWordIds[1], boardWordIds[5], boardWordIds[9], boardWordIds[13]])
                  : lineKey == 'line-6'
                    ? markedWordIds.hasAll([boardWordIds[2], boardWordIds[6], boardWordIds[10], boardWordIds[14]])
                    : lineKey == 'line-7'
                      ? markedWordIds.hasAll([boardWordIds[3], boardWordIds[7], boardWordIds[11], boardWordIds[15]])
                      : lineKey == 'line-8'
                        ? markedWordIds.hasAll([boardWordIds[0], boardWordIds[5], boardWordIds[10], boardWordIds[15]])
                        : lineKey == 'line-9'
                          ? markedWordIds.hasAll([boardWordIds[3], boardWordIds[6], boardWordIds[9], boardWordIds[12]])
                          : false;
    }

    function isBingoPlayerCompletedLineKeyCompleteByBoardSize(boardWordIds, markedWordIds, lineKey, boardSize) {
      return boardSize == 3
        ? isBingoPlayerCompletedLineKeyComplete3(boardWordIds, markedWordIds, lineKey)
        : boardSize == 4
          ? isBingoPlayerCompletedLineKeyComplete4(boardWordIds, markedWordIds, lineKey)
          : false;
    }

    function isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, addedIndex, boardSize) {
      return !previousLineKeys.hasAny([completedLineKeys[previousLineKeys.size() + addedIndex]])
        && isBingoPlayerCompletedLineKeyCompleteByBoardSize(
          boardWordIds,
          markedWordIds,
          completedLineKeys[previousLineKeys.size() + addedIndex],
          boardSize
        );
    }

    function isBingoPlayerCompletedLineKeysVerified(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, boardSize) {
      return completedLineKeys.size() == previousLineKeys.size()
        ? completedLineKeys == previousLineKeys
        : completedLineKeys.hasAll(previousLineKeys)
          && (
            completedLineKeys.size() == previousLineKeys.size() + 1
              ? isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 0, boardSize)
              : completedLineKeys.size() == previousLineKeys.size() + 2
                ? completedLineKeys[previousLineKeys.size()] != completedLineKeys[previousLineKeys.size() + 1]
                  && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 0, boardSize)
                  && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 1, boardSize)
                : completedLineKeys.size() == previousLineKeys.size() + 3
                  ? completedLineKeys[previousLineKeys.size()] != completedLineKeys[previousLineKeys.size() + 1]
                    && completedLineKeys[previousLineKeys.size()] != completedLineKeys[previousLineKeys.size() + 2]
                    && completedLineKeys[previousLineKeys.size() + 1] != completedLineKeys[previousLineKeys.size() + 2]
                    && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 0, boardSize)
                    && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 1, boardSize)
                    && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 2, boardSize)
                  : completedLineKeys.size() == previousLineKeys.size() + 4
                    ? completedLineKeys[previousLineKeys.size()] != completedLineKeys[previousLineKeys.size() + 1]
                      && completedLineKeys[previousLineKeys.size()] != completedLineKeys[previousLineKeys.size() + 2]
                      && completedLineKeys[previousLineKeys.size()] != completedLineKeys[previousLineKeys.size() + 3]
                      && completedLineKeys[previousLineKeys.size() + 1] != completedLineKeys[previousLineKeys.size() + 2]
                      && completedLineKeys[previousLineKeys.size() + 1] != completedLineKeys[previousLineKeys.size() + 3]
                      && completedLineKeys[previousLineKeys.size() + 2] != completedLineKeys[previousLineKeys.size() + 3]
                      && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 0, boardSize)
                      && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 1, boardSize)
                      && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 2, boardSize)
                      && isBingoPlayerCompletedLineKeyAddedAndComplete(boardWordIds, markedWordIds, completedLineKeys, previousLineKeys, 3, boardSize)
                    : false
          );
    }

    function isBingoPlayerCompletedLineKeysUpdateAllowed() {
      return request.resource.data.completedLineKeys is list
        && request.resource.data.completedLineKeys.size() == request.resource.data.bingoLines
        && request.resource.data.completedLineKeys.hasAll(resource.data.completedLineKeys)
        && isBingoPlayerCompletedLineKeysAllowedByBoardSize(
          request.resource.data.completedLineKeys,
          resource.data.boardSize
        )
        && isBingoPlayerCompletedLineKeysVerified(
          resource.data.boardWordIds,
          request.resource.data.markedWordIds,
          request.resource.data.completedLineKeys,
          resource.data.completedLineKeys,
          resource.data.boardSize
        );
    }

    function isBingoPlayerRankUpdateAllowed() {
      return request.resource.data.bingoRank == resource.data.bingoRank
        || (
          resource.data.bingoRank == null
          && request.resource.data.hasBingo == true
          && request.resource.data.bingoRank == 1
        );
    }

    function isBingoPlayerCreate(sessionId, playerId) {
      return bingoSessionExists(sessionId)
        && bingoSessionDoc(sessionId).data.status == 'live'
        && request.resource.data.studentNameNormalized == playerId
        && request.resource.data.boardSize == bingoSessionDoc(sessionId).data.boardSize
        && request.resource.data.requiredCellCount == bingoSessionDoc(sessionId).data.requiredCellCount
        && isBingoPlayerAvailableWordsAllowedBySession(
          request.resource.data.availableWords,
          bingoSessionDoc(sessionId).data.vocabularyItems,
          request.resource.data.boardSize
        )
        && request.resource.data.setupStatus == 'arranging'
        && isBingoPlayerCreateDocument(request.resource.data)
        && request.resource.data.markedWordIds.size() == 0
        && request.resource.data.bingoLines == 0
        && request.resource.data.completedLineKeys.size() == 0
        && request.resource.data.hasBingo == false
        && request.resource.data.bingoRank == null;
    }

    function isBingoPlayerDraftUpdate(sessionId, playerId) {
      return bingoSessionExists(sessionId)
        && bingoSessionDoc(sessionId).data.status == 'live'
        && resource.data.setupStatus == 'arranging'
        && request.resource.data.studentNameNormalized == playerId
        && request.resource.data.keys().hasOnly([
          'studentName',
          'studentNameNormalized',
          'boardSize',
          'requiredCellCount',
          'setupStatus',
          'availableWords',
          'boardCells',
          'boardWordIds',
          'markedWordIds',
          'bingoLines',
          'completedLineKeys',
          'hasBingo',
          'bingoRank',
          'setupStartedAt',
          'setupCompletedAt',
          'joinedAt',
          'updatedAt'
        ])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.studentNameNormalized == resource.data.studentNameNormalized
        && request.resource.data.studentName == resource.data.studentName
        && request.resource.data.boardSize == resource.data.boardSize
        && request.resource.data.requiredCellCount == resource.data.requiredCellCount
        && request.resource.data.boardSize == bingoSessionDoc(sessionId).data.boardSize
        && request.resource.data.requiredCellCount == bingoSessionDoc(sessionId).data.requiredCellCount
        && request.resource.data.setupStatus == 'arranging'
        && request.resource.data.availableWords == resource.data.availableWords
        && isBingoPlayerAvailableWordsAllowedBySession(
          request.resource.data.availableWords,
          bingoSessionDoc(sessionId).data.vocabularyItems,
          request.resource.data.boardSize
        )
        && request.resource.data.boardWordIds is list
        && request.resource.data.boardCells is list
        && request.resource.data.boardCells.size() == resource.data.boardCells.size()
        && isBingoPlayerBoardWordIdsAllowedByBoardSize(
          request.resource.data.boardWordIds,
          request.resource.data.availableWords,
          request.resource.data.boardSize
        )
        && isBingoDraftBoardCellsMatchByBoardSize(
          request.resource.data.boardCells,
          request.resource.data.boardWordIds,
          request.resource.data.boardSize
        )
        && request.resource.data.boardWordIds.size() <= request.resource.data.boardSize * request.resource.data.boardSize
        && request.resource.data.markedWordIds == resource.data.markedWordIds
        && request.resource.data.bingoLines == 0
        && request.resource.data.completedLineKeys is list
        && request.resource.data.completedLineKeys.size() == 0
        && request.resource.data.hasBingo == false
        && request.resource.data.bingoRank == null
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.setupStartedAt == resource.data.setupStartedAt
        && request.resource.data.setupCompletedAt == null
    }

    function isBingoPlayerFinalizeUpdate(sessionId, playerId) {
      return bingoSessionExists(sessionId)
        && bingoSessionDoc(sessionId).data.status == 'live'
        && resource.data.setupStatus == 'arranging'
        && request.resource.data.studentNameNormalized == playerId
        && isBingoPlayerCommonKeys(request.resource.data)
        && request.resource.data.studentNameNormalized == resource.data.studentNameNormalized
        && request.resource.data.studentName == resource.data.studentName
        && request.resource.data.boardSize == resource.data.boardSize
        && request.resource.data.requiredCellCount == resource.data.requiredCellCount
        && request.resource.data.availableWords == resource.data.availableWords
        && request.resource.data.setupStatus == 'ready'
        && request.resource.data.boardCells is list
        && request.resource.data.boardCells.size() == resource.data.boardCells.size()
        && request.resource.data.boardWordIds is list
        && request.resource.data.boardWordIds.size() == request.resource.data.boardSize * request.resource.data.boardSize
        && isBingoPlayerBoardWordIdsMatchAvailableByBoardSize(
          request.resource.data.boardWordIds,
          request.resource.data.availableWords,
          request.resource.data.boardSize
        )
        && isBingoBoardCellsMatchBoardWordIdsByBoardSize(
          request.resource.data.boardCells,
          request.resource.data.boardWordIds,
          request.resource.data.boardSize
        )
        && request.resource.data.markedWordIds.size() == 0
        && request.resource.data.bingoLines == 0
        && request.resource.data.completedLineKeys is list
        && request.resource.data.completedLineKeys.size() == 0
        && request.resource.data.hasBingo == false
        && request.resource.data.bingoRank == null
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.setupStartedAt == resource.data.setupStartedAt
        && request.resource.data.setupCompletedAt is timestamp
    }

    function isBingoPlayerMarkUpdate(sessionId, playerId) {
      return bingoSessionExists(sessionId)
        && bingoSessionDoc(sessionId).data.status == 'live'
        && resource.data.setupStatus == 'ready'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'markedWordIds',
          'bingoLines',
          'completedLineKeys',
          'hasBingo',
          'bingoRank',
          'updatedAt'
        ])
        && resource.data.studentNameNormalized == playerId
        && request.resource.data.updatedAt is timestamp
        && bingoSessionDoc(sessionId).data.calledWordIds.hasAny([bingoSessionActiveWordId(sessionId)])
        && resource.data.boardWordIds.hasAny([bingoSessionActiveWordId(sessionId)])
        && request.resource.data.markedWordIds.hasAll(resource.data.markedWordIds)
        && request.resource.data.markedWordIds.size() == resource.data.markedWordIds.size() + 1
        && !resource.data.markedWordIds.hasAny([bingoSessionActiveWordId(sessionId)])
        && request.resource.data.markedWordIds[resource.data.markedWordIds.size()] == bingoSessionActiveWordId(sessionId)
        && request.resource.data.bingoLines == isBingoPlayerBoardLinesCompletedByBoardSize(
          resource.data.boardWordIds,
          request.resource.data.markedWordIds,
          resource.data.boardSize
        )
        && isBingoPlayerCompletedLineKeysUpdateAllowed()
        && request.resource.data.hasBingo == (request.resource.data.bingoLines >= 3)
        && isBingoPlayerRankUpdateAllowed()
        ;
    }

    function isBingoPlayerUpdate(sessionId, playerId) {
      return resource.data.setupStatus == 'arranging'
        ? request.resource.data.setupStatus == 'arranging'
          ? isBingoPlayerDraftUpdate(sessionId, playerId)
          : request.resource.data.setupStatus == 'ready'
            ? isBingoPlayerFinalizeUpdate(sessionId, playerId)
            : false
        : resource.data.setupStatus == 'ready'
          ? request.resource.data.setupStatus == 'ready'
            ? isBingoPlayerMarkUpdate(sessionId, playerId)
            : false
          : false;
    }

    match /bingoSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if isBingoSessionCreate(sessionId);
      allow update: if isBingoSessionUpdate(sessionId);
      allow delete: if false;

      match /players/{playerId} {
        allow get: if true;
        allow list: if bingoSessionExists(sessionId);
        allow create: if isBingoPlayerCreate(sessionId, playerId);
        allow update: if isBingoPlayerUpdate(sessionId, playerId);
        allow delete: if false;
      }
    }
  }
}
